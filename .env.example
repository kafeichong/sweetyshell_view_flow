# ==========================================
# Video Flow 环境变量配置
# ==========================================

# 数据库密码（生产环境请修改）
DB_PASSWORD=your_strong_password_here

# CORS 允许的来源（多个用逗号分隔）
CORS_ORIGIN=http://localhost:3101,http://服务器IP:3101

# Worker 服务令牌：v1 内部接口与 /api/tasks 的 claim/recover/update 均校验。
# 必须与 Worker 的 WORKER_SERVICE_TOKEN 一致；未配置时 Worker 无法领取任务（fail-closed）。
VIDEO_FLOW_WORKER_TOKEN=replace_with_a_long_random_service_token
VIDEO_FLOW_ADMIN_TOKEN=replace_with_a_separate_admin_token
# Backend 使用这些变量直接生成 OSS 预签名 URL

# ComfyUI 客户端使用的 actor token（只放在同事本机）
VIDEO_FLOW_BACKEND_URL=http://localhost:3100
VIDEO_FLOW_TOKEN=replace_with_actor_token
# ComfyUI Desktop 无法注入 VIDEO_FLOW_TOKEN 时，从该文件读取；默认 ~/.video-flow/token。
# VIDEO_FLOW_TOKEN 非空时优先于该文件。token 文件权限应设置为 600。
VIDEO_FLOW_TOKEN_FILE=~/.video-flow/token
VIDEO_FLOW_PROTOCOL_VERSION=1

# Production 准入白名单：只有列出的 actor 能创建真实付费任务（逗号分隔）。
# 留空或未配置 = Production 对所有人关闭。灰度期间只填 1 个 actor。
VIDEO_FLOW_PRODUCTION_ACTORS=

# 火山引擎 API Key
VOLCENGINE_ACCESS_KEY=your_volcengine_api_key

# 阿里云 OSS
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET=sweetyshell-ai-assets
OSS_REGION=oss-cn-beijing
