# ==========================================
# Video Flow 环境变量配置
# ==========================================

# 数据库密码（生产环境请修改）
DB_PASSWORD=your_strong_password_here

# CORS 允许的来源（多个用逗号分隔）
CORS_ORIGIN=http://localhost:3101,http://服务器IP:3101

# Worker 服务令牌：v1 内部接口与 /api/tasks 的 claim/recover/update 均校验。
# 必须与 Worker 的 WORKER_SERVICE_TOKEN 一致；未配置时 Worker 无法领取任务（fail-closed）。
VIDEO_FLOW_WORKER_TOKEN=replace_with_a_long_random_service_token
VIDEO_FLOW_ADMIN_TOKEN=replace_with_a_separate_admin_token
# Backend 使用这些变量直接生成 OSS 预签名 URL

# ComfyUI 客户端使用的 Backend 地址与 actor token（只放在同事本机）。
# 公司服务器部署后必须填写公网 HTTPS，例如 https://ai.sweetyshell.com；
# http://localhost:3100 只表示 Backend 也运行在当前这台个人电脑上。
VIDEO_FLOW_BACKEND_URL=http://localhost:3100
VIDEO_FLOW_TOKEN=replace_with_actor_token
# ComfyUI Desktop 无法注入 VIDEO_FLOW_TOKEN 时，从该文件读取；默认 ~/.video-flow/token。
# VIDEO_FLOW_TOKEN 非空时优先于该文件。token 文件权限应设置为 600。
VIDEO_FLOW_TOKEN_FILE=~/.video-flow/token
VIDEO_FLOW_PROTOCOL_VERSION=1

# Production 准入白名单：只有列出的 actor 能创建真实付费任务（逗号分隔）。
# 留空或未配置 = Production 对所有人关闭。灰度期间只填 1 个 actor。
VIDEO_FLOW_PRODUCTION_ACTORS=
# 以下固定 ProductionSpec 只保留给旧任务/旧测试迁移，新 v2 正式任务不得读取其中的
# duration/ratio/resolution/reserveCny。R4 完成前新 v2 Production 保持关闭。
# 示例仅表示字段结构，不是有效模型、价格或预算：
# VIDEO_FLOW_PRODUCTION_SPEC_JSON={"version":"approved-v1","model":"replace-after-verification","duration":5,"ratio":"16:9","resolution":"replace-after-verification","generateAudio":false,"watermark":true,"pricingVersion":"replace-after-verification","reserveCny":"0.000000"}
VIDEO_FLOW_PRODUCTION_SPEC_JSON=

# Seedance 2.5 v2 报价默认使用公开刊例价，只用于估算/预算，不冒充最终账单。
# 如果当前账户/订单有已确认价格，填写完整、带有效期的 JSON；格式错误会 fail-closed。
# VIDEO_FLOW_SEEDANCE_25_ACCOUNT_PRICING_JSON={"pricingVersion":"ark-order-2026-09-15","source":"volcengine_order","validFrom":"2026-09-15T00:00:00+08:00","validUntil":"2026-10-01T00:00:00+08:00","rates":{"withoutVideo":{"480p":"70.00","720p":"70.00","1080p":"77.00"},"withVideo":{"480p":"42.00","720p":"42.00","1080p":"46.00"}}}
VIDEO_FLOW_SEEDANCE_25_ACCOUNT_PRICING_JSON=
# 促销只有确认适用于当前账户后才能列入；逗号分隔。留空表示不自动套用公开促销。
VIDEO_FLOW_SEEDANCE_25_CONFIRMED_PROMOTION_IDS=

# T02: 每日任务数量限制（全局）
VIDEO_FLOW_DAILY_TASK_LIMIT=10

# T02: 最大待执行任务数（全局）
VIDEO_FLOW_MAX_PENDING_TASKS=5

# T09: 审计目录。Backend 与 Worker 各写各的子目录，互不覆盖；两者都必须在
# 服务器上受限且持久（docker-compose 里映射同一个 /app/audit 卷）。
# Backend 通过 VIDEO_FLOW_WORKER_AUDIT_DIR 读取 Worker 的事件做任务报表。
VIDEO_FLOW_AUDIT_DIR=/app/audit/backend
VIDEO_FLOW_WORKER_AUDIT_DIR=/app/audit/worker

# T10: 巡检脚本。Admin token 与通知渠道都只从文件读取（FILE 内容为单行值，
# 权限 600）。未配置 ALERT_WEBHOOK_FILE 时脚本只做 dry-run，不得据此签收告警。
VIDEO_FLOW_ADMIN_TOKEN_FILE=~/.video-flow/admin-token
# VIDEO_FLOW_ALERT_WEBHOOK_FILE=~/.video-flow/alert-webhook
# 巡检状态（首次/去重/恢复通知与待通知记录）落盘位置
VIDEO_FLOW_MONITOR_STATE=~/.video-flow/monitor-state.json
# 磁盘阈值检查路径（日志/输出所在的卷）
VIDEO_FLOW_DISK_PATH=/data/video-flow

# 火山引擎 API Key
VOLCENGINE_ACCESS_KEY=your_volcengine_api_key

# Worker 侧 Provider 地址。生产服务器直接访问 Ark，使用下面的默认 HTTPS 地址。
# 本机合同测试可用 http://127.0.0.1:19091/api/v3，因为 Fake Provider 与测试脚本同机。
# Worker 位于 Docker 且 Fake Provider 是另一容器时，应使用
# http://fake-provider:19091/api/v3；容器内的 127.0.0.1 只指向该容器自身。
# 非 Ark 地址仅允许在 VIDEO_FLOW_TEST_MODE=true 时使用，且不得同时注入真实 Provider 密钥。
VIDEO_FLOW_TEST_MODE=false
VIDEO_FLOW_PROVIDER_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 阿里云 OSS
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET=sweetyshell-ai-assets
OSS_REGION=oss-cn-beijing
