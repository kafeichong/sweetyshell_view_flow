{
  "1": {
    "class_type": "VideoFlowConfig",
    "inputs": {
      "backend_url": "https://ai.sweetyshell.com",
      "protocol_version": "1"
    }
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "reference.png"
    }
  },
  "3": {
    "class_type": "VideoFlowSeedanceProduction",
    "inputs": {
      "config": ["1", 0],
      "prompt": "产品从水面浮现，镜头平滑推进",
      "image": ["2", 0],
      "duration": 5,
      "ratio": "16:9",
      "generation_version": 1
    }
  },
  "4": {
    "class_type": "VideoFlowWaitTask",
    "inputs": {
      "config": ["1", 0],
      "task_id": ["3", 0],
      "timeout_seconds": 1200
    }
  },
  "5": {
    "class_type": "VideoFlowLoadResult",
    "inputs": {
      "config": ["1", 0],
      "task_id": ["4", 0]
    }
  }
}
