  "contentRules": {
    "source": "官方创建视频生成任务接口文档 https://docs.volcengine.com/docs/82379/1520757（2026-09-16 用本机浏览器逐段核对）",
    "combinations": [
      "纯文本",
      "文本（可选）+ 图片",
      "文本（可选）+ 视频",
      "文本（可选）+ 音频（仅 Seedance 2.5 支持单独传入音频）",
      "文本（可选）+ 图片 + 音频",
      "文本（可选）+ 图片 + 视频",
      "文本（可选）+ 视频 + 音频",
      "文本（可选）+ 图片 + 视频 + 音频"
    ],
    "minimumReferenceMaterials": 1,
    "minimumReferenceMaterialsRule": "全模态参考（参考生视频）要求 content 中至少包含一个 role 为 reference_image / reference_video / reference_audio 的参考素材；图片 0-30 张、视频 0-10 段、音频 0-10 段可自由组合。文本提示词对该任务类型是可选字段。",
    "taskTypeExclusivity": {
      "rule": "图生视频-首帧、图生视频-首尾帧、全模态参考生视频是 3 种**互斥**场景，不可混用：first_frame / last_frame 与 reference_* 不能出现在同一个 content 里。",
      "note": "全模态参考可通过提示词指定参考图充当首帧/尾帧；要严格保证与指定图一致时，用专门的首尾帧任务类型。",
      "taskTypes": [
        "first_frame_to_video",
        "first_last_frame_to_video",
        "omni_reference"
      ]
    },
    "omniReferenceTaskType": {
      "field": "omni_reference_task_type",
      "values": [
        "auto",
        "reference",
        "edit",
        "extend"
      ],
      "default": "auto",
      "explicitValueEffect": "显式指定时，接口在**提交任务时提前校验**该任务类型的特殊参数限制，不符合立即报错、任务不创建；auto 时由模型判定，判定冲突会异步报错 InvalidParameter.TaskTypeConstraint。",
      "promptIntentRisk": "模型仍会结合提示词判定任务类型：提示词写成编辑或延长意图时，实际判定可能与本节指定的值不一致，任务在**提交成功之后**异步失败（InvalidParameter.TaskTypeMismatch，官方只对成功生成的视频计费）。客户端据此在提示词输入项上给出写法提示。"
    },
    "durationReturnSemantics": {
      "formula": "查询接口返回的 duration = 实际总帧数 / 24（向下取整）",
      "officialExample": "最终生成 133 帧 → 133 / 24 = 5.54 秒 → 返回 5",
      "whyItMatters": "官方自己说明帧数与「时长 × 帧率」不相等，这既解释了实测到的「+1 帧」，也说明计费按实际出片帧数计是官方口径。"
    },
    "evidence": [
      "official-seedance-2.5-create-task-api",
      "official-seedance-2.5-reference-combinations"
    ]
  },
