    "estimate": {
      "formula": "(inputVideoSeconds + outputVideoSeconds) * width * height * outputFrameRate / 1024",
      "outputFrameRate": 24,
      "inputVideoSecondsPolicy": "sum_all_reference_video_durations",
      "adaptiveRatioPolicy": "derive_from_locked_input_when_officially_locked_otherwise_use_a_documented_bound",
      "automaticDurationPolicy": "use_a_documented_bound_or_mark_unavailable"
    },
    "inputVideoMinimumTokens": {
      "applies": true,
      "appliesWhen": "input_includes_reference_video",
      "status": "resolved",
      "dependsOn": ["resolution", "ratio", "outputDuration"],
      "minimumTotalSeconds": "ceil(outputDuration * 5 / 3)",
      "rule": "billedTokens = max((inputVideoSeconds + outputDuration) * width * height * outputFrameRate / 1024, ceil(outputDuration * 5 / 3) * width * height * outputFrameRate / 1024)",
      "reference": "Official Seedance 2.5 minimum-token table or account price calculator linked from the catalog page",
      "evidence": {
        "source": "火山方舟视频生成模型价格快查表（官方公开分享的飞书文档）",
        "sourceUrl": "https://bytedance.larkoffice.com/wiki/FXaYwxzJ5i5Zdik32ipcWzt7nxd",
        "verifiedOn": "2026-09-15",
        "verification": "read_the_official_table_directly",
        "verifiedPoints": 96,
        "covered": [
          "官方『seedance-2.5系列最低token限制』视图 480p/720p/1080p 子视图，16:9 输出 4-30 秒：81 行逐位一致",
          "官方 480p 4:3、1:1、21:9 行：3 点一致",
          "官方『seedance-2.5系列价格』视图 720p 含输入视频：输入 2/3/4 秒落在同一下限 194,400，输入 5/10/15/20/25/30 秒逐个等于公式值",
          "官方 1080p 含输入视频：输入 2/3 秒下限 437,400、价格 20.12",
          "官方价格示例 2.5 与 2.0 的真实像素尺寸：12 点一致",
          "官方 seedance2.5 价格计算器自身的公式：输入含视频时『视频价格 = 单价 × MAX(估算token用量, 最低token用量) / 1000000』",
          "官方最低 token 表自身的『输入时长』列：140/140 行等于 ceil(2 × 输出时长 / 3)，覆盖输出 4-30 秒全部取值"
        ],
        "note": "规则已直接对照官方快查表与官方价格计算器核对（2026-09-15）：计费口径 MAX(估算, 最低) 来自官方计算器内嵌公式，最低值来自官方表，而『输出时长 × 5/3 向上取整』等价于官方表自己存的输入时长下限 ceil(2×输出时长/3)（140/140 行吻合）。因此本实现的三部分均有官方依据，不再只是经验拟合。仍需注意：官方来源的输入时长都是整数秒（表为整数列、计算器为 2-30 下拉），未覆盖非整数秒，本实现按精确小数秒计算，这一点无官方依据。"
      },
      "productionQuotePolicy": "reserve_the_max_of_formula_and_minimum"
    },
    "accountPrice": {
      "publicCatalogIsFinalBill": false,
      "sourcePolicy": "actual_account_or_order_result_controls",
      "productionQuotePolicy": "freeze_the_confirmed_applicable_rate_and_conditions"
    },
