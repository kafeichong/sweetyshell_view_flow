// MVP 版本 - 5+ 表

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  draft
  pending
  queued
  in_progress
  requires_review
  completed
  failed
  cancelled
}

enum AttemptStatus {
  pending
  submitted
  running
  requires_review
  completed
  failed
  cancelled
}

enum ExecutionMode {
  preview
  production
  comfyui
}

enum CostStatus {
  estimated
  usage_calculated
  billed
  unavailable
}

// 任务表
model Task {
  id String @id @default(uuid()) @db.Uuid

  // 创建者（兼容旧接口）
  createdBy String @map("created_by")

  // 新身份域字段（可空，新链路逐步切入）
  actorId         String?     @map("actor_id")
  clientRequestId String?     @map("client_request_id")
  capability      String?     @map("capability")
  workflowName    String?     @map("workflow_name")
  workflowVersion String?     @map("workflow_version")
  workflowHash    String?     @map("workflow_hash")
  requestSnapshot Json?       @map("request_snapshot")
  executionPlan  Json?        @map("execution_plan")
  deliveryStatus String?      @map("delivery_status")
  taskStatus      TaskStatus? @map("task_status")
  executionSlotId String?     @map("execution_slot_id")
  slotSequence    Int?        @map("slot_sequence")
  preflightId     String?     @map("preflight_id") @db.Uuid
  contractDigest  String?     @map("contract_digest")
  intentDigest    String?     @map("intent_digest")
  quoteDigest     String?     @map("quote_digest")
  clientDeliveryStatus String?   @map("client_delivery_status")
  clientDeliveredAt     DateTime? @map("client_delivered_at")

  // 输入
  prompt   String
  imageUrl String? @map("image_url")

  // 输出
  videoUrl String? @map("video_url")

  // 状态
  status   String  @default("pending") // pending, running, completed, failed
  errorMsg String? @map("error_msg")

  // 费用
  cost Decimal? @db.Decimal(18, 6)

  // 时间
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  // Worker claim lease（用于并发领取和恢复）
  leaseOwner     String?   @map("lease_owner")
  leaseExpiresAt DateTime? @map("lease_expires_at")

  // 关联
  executionAttempts ExecutionAttempt[]
  assets            Asset[]
  budgetReservation TaskBudgetReservation?

  @@unique([actorId, clientRequestId])
  @@index([status])
  @@index([createdBy])
  @@index([actorId])
  @@index([status, leaseExpiresAt])
  @@unique([actorId, executionSlotId, slotSequence])
  @@index([actorId, executionSlotId, clientDeliveryStatus])
  @@map("tasks")
}

// 执行尝试
model ExecutionAttempt {
  id                     String        @id @default(uuid()) @db.Uuid
  taskId                 String        @map("task_id") @db.Uuid
  task                   Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attemptNo              Int           @map("attempt_no")
  mode                   ExecutionMode @map("mode")
  provider               String
  model                  String?
  providerTaskId         String?       @map("provider_task_id")
  status                 AttemptStatus @default(pending) @map("status")
  providerUsage          Json?         @map("provider_usage")
  costStatus             CostStatus    @default(unavailable) @map("cost_status")
  estimatedCostCny       Decimal?      @map("estimated_cost_cny") @db.Decimal(18, 6)
  usageCalculatedCostCny Decimal?      @map("usage_calculated_cost_cny") @db.Decimal(18, 6)
  billedCostCny          Decimal?      @map("billed_cost_cny") @db.Decimal(18, 6)
  pricingVersion         String?       @map("pricing_version")
  failureType            String?       @map("failure_type")
  failureCode            String?       @map("failure_code")
  failureMessage         String?       @map("failure_message")
  submittedAt            DateTime?     @map("submitted_at")
  startedAt              DateTime?     @map("started_at")
  finishedAt             DateTime?     @map("finished_at")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  assets Asset[]

  @@unique([taskId, attemptNo])
  @@unique([providerTaskId])
  @@index([status])
  @@map("execution_attempts")
}

// 素材表
model Asset {
  id               String            @id @default(uuid()) @db.Uuid
  ownerId          String?           @map("owner_id")
  taskId           String?           @map("task_id") @db.Uuid
  task             Task?             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attemptId        String?           @map("attempt_id") @db.Uuid
  attempt          ExecutionAttempt? @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  role             String
  mediaType        String?           @map("media_type")
  bucket           String?
  objectKey        String            @map("object_key")
  mimeType         String?           @map("mime_type")
  sizeBytes        BigInt?           @map("size_bytes")
  fileHash         String?           @map("file_hash")
  inspectionStatus String?           @map("inspection_status")
  mediaMetadata   Json?             @map("media_metadata")
  // 这份 media_metadata 是哪一版检查器算的；复用旧资产时用它判断要不要重检。
  inspectorVersion String?          @map("inspector_version")
  createdAt        DateTime          @default(now()) @map("created_at")

  @@unique([ownerId, role, fileHash])
  @@map("assets")
}

// 授权凭证
model ActorCredential {
  id              String    @id @default(uuid()) @db.Uuid
  actorId         String    @unique @map("actor_id")
  name            String
  tokenHash       String    @map("token_hash")
  status          String    @default("active")
  dailyLimitCny   Decimal?  @map("daily_limit_cny") @db.Decimal(18, 6)
  monthlyLimitCny Decimal?  @map("monthly_limit_cny") @db.Decimal(18, 6)
  lastUsedAt      DateTime? @map("last_used_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("actor_credentials")
}

// T02: 任务预算预占表
model TaskBudgetReservation {
  id              String   @id @default(uuid()) @db.Uuid
  taskId          String   @unique @map("task_id") @db.Uuid
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId         String   @map("actor_id")
  reservedCny     Decimal  @map("reserved_cny") @db.Decimal(18, 6)
  settledCny      Decimal? @map("settled_cny") @db.Decimal(18, 6)
  state           String   @default("reserved")
  dayKey          String   @map("day_key")
  monthKey        String   @map("month_key")
  pricingVersion  String   @map("pricing_version")
  // T05: 人工账单复核痕迹。operator 是管理员声明的操作者，不是 token 识别出的员工身份。
  reviewDecision   String?   @map("review_decision")
  reviewAmountCny  Decimal?  @map("review_amount_cny") @db.Decimal(18, 6)
  reviewEvidenceRef String?  @map("review_evidence_ref")
  reviewOperator   String?   @map("review_operator")
  reviewedAt       DateTime? @map("reviewed_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([actorId, dayKey])
  @@index([actorId, monthKey])
  @@index([state])
  @@map("task_budget_reservations")
}

// T02: 生产准入开关（单例）
model ProductionGate {
  id        String   @id @default("production")
  paused    Boolean  @default(true)
  reason    String?
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("production_gates")
}

// v2 Preview 预检记录：不可被 Worker 领取，不关联 Task / Attempt / 预算预占。
model PreflightRecord {
  id               String   @id @default(uuid()) @db.Uuid
  actorId          String   @map("actor_id")
  createdAt        DateTime @default(now()) @map("created_at")
  expiresAt        DateTime @map("expires_at")
  contractVersion  Int      @map("contract_version")
  workflowVersion  String   @map("workflow_version")
  contractDigest   String   @map("contract_digest")
  intentDigest     String   @map("intent_digest")
  quoteDigest      String   @map("quote_digest")
  effectiveRequest Json     @map("effective_request")
  report           Json
  quoteSnapshot    Json     @map("quote_snapshot")

  @@index([actorId, createdAt])
  @@index([expiresAt])
  @@map("preflight_records")
}

// 配置表（单条记录）
model Config {
  id String @id @default("default")

  // 火山引擎
  volcengineApiKey String @map("volcengine_api_key")

  // 阿里云 OSS
  ossAccessKeyId     String @map("oss_access_key_id")
  ossAccessKeySecret String @map("oss_access_key_secret")
  ossBucket          String @default("sweetyshell-ai-assets") @map("oss_bucket")
  ossRegion          String @default("oss-cn-beijing") @map("oss_region")

  @@map("config")
}
